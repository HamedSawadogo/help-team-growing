DB_NAME=commerceops
DB_USER=commerceops
DB_PASSWORD=change-me
DB_PORT=5432
DB_POOL_SIZE=10

BACKEND_PORT=8080
# Matches the basic_auth block hardcoded in monitoring/prometheus/prometheus.yml
# (Prometheus does not read this .env file). If you change this, update that
# file too, or Prometheus will get 401s scraping /actuator/prometheus.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# SMALL | MEDIUM | LARGE - LARGE should only be generated on demand via
# POST /api/admin/seed?profile=LARGE, not left as the startup default.
SEED_ENABLED=true
SEED_PROFILE=MEDIUM

PAYMENT_LATENCY_MS=150
PAYMENT_JITTER_MS=100
PAYMENT_FAILURE_RATE=0.03
